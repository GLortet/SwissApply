{
  "name": "swissapply-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/apps/web/server.js",
    "start": "node dist/apps/web/server.js",
    "test": "npm run build && node --test dist/packages/domain/*.test.js dist/apps/web/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "26.1.2",
    "@types/pdfkit": "^0.17.3",
    "docx": "^9.5.1",
    "pdfkit": "^0.17.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.296"
  }
}
