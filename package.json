{
  "name": "swissapply-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/apps/web/server.js",
    "start": "node dist/apps/web/server.js",
    "test": "npm run build && node --test dist/packages/domain/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": { "node": ">=20" }
}
